---
import { z } from "astro:content";

import Anchor from "@components/Anchor.astro";
import PacientFieldset from "@components/fieldsets/PacientFieldset.astro";
import ArrowIcon from "@components/icons/Arrow.astro";
import PenIcon from "@components/icons/Pen.astro";
import LoggedInPage from "@components/LoggedInPage.astro";
import { PacientSchema } from "@core/pacient/types";
import numberOrString from "@core/shared/schemas/number_or_string";
import searchParam from "@core/shared/utils/searchParam";
import { UserSchema } from "@core/user/types";
import { appointmentRepository, config, pacientRepository } from "src";
import PaginationControls from "@components/PaginationControls.astro";

const GetPacientDto = z.object({
	userId: UserSchema.shape.id,
	pacientId: PacientSchema.shape.id,
	pageNumber: numberOrString.default(1),
	pageSize: numberOrString.default(config.pacientAppointmentsListDefaultPageSize)
});

const { userId, pacientId, pageNumber, pageSize } = GetPacientDto.parse({ 
	userId: Astro.locals.userId, 
    pacientId: Astro.params.pacientId,
	pageNumber: searchParam(Astro.url, 'pageNumber'),
	pageSize: searchParam(Astro.url, 'pageSize')
});

const pacient = await pacientRepository.findById(userId, pacientId);
const appointments = await appointmentRepository.findByPacientId(userId, pacientId, { number: pageNumber, size: pageSize });

---
<LoggedInPage title="Paciente" class="flex-column flex-items-center gap-md">
    <Anchor href="/pacient" class="flex-self-start">
        <ArrowIcon direction="left" width="1.5rem" height="1.5rem"/>
        <span>Voltar</span>
    </Anchor>
    <div class="content-wrapper card-lg flex-column">
        <PacientFieldset
            pacient={pacient} 
            disabled
        />
        <Anchor href={`/pacient/${pacientId}/edit`} class="flex-self-end">
            <PenIcon width="1rem" height="1rem"/>
            Editar
        </Anchor>
    </div>
    <div class="content-wrapper card-lg flex-column">
        <header class="content-faded padding-md border-bottom">
            Consultas
        </header>

        {appointments.data.map(appointment => (
            <a 
                href={`/appointment/${appointment.id}`}
                class="grid grid-flow-row padding-md gap-md"
                style={{gridTemplateColumns: '9ch auto'}}
            >
                <span>{appointment.date.toLocaleDateString('pt-br')}</span>
                <span class="truncate">
                    {appointment.description}
                </span>
            </a>
        ))}

        <div class="flex-row flex-space-between">
            <Anchor href={`/appointment/pacient/${pacientId}/create`}>+ Nova Consulta</Anchor>
            <PaginationControls 
                pageNumber={pageNumber}
                pageSize={pageSize}
                totalCount={appointments.count}
                href={`/pacient/${pacientId}`}
            />
        </div>
    </div>
</LoggedInPage>