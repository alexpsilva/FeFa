---
import { z } from "astro:content";

import Anchor from "@components/Anchor.astro";
import Button from "@components/Button.astro";
import AppointmentFieldset from "@components/fieldsets/AppointmentFieldset.astro";
import Form from "@components/Form.astro";
import CrossIcon from "@components/icons/Cross.astro";
import SaveIcon from "@components/icons/Save.astro";
import LoggedInPage from "@components/LoggedInPage.astro";
import { PacientSchema } from "@core/pacient/types";
import { UserSchema } from "@core/user/types";
import { pacientRepository } from "src";

const CreateAppointmentDto = z.object({
	userId: UserSchema.shape.id,
	pacientId: PacientSchema.shape.id,
});

const { userId, pacientId } = CreateAppointmentDto.parse({ 
	userId: Astro.locals.userId, 
    pacientId: Astro.params.pacientId,
});

const pacient = await pacientRepository.findById(userId, pacientId);

---
<LoggedInPage title="Criar Consulta" class="flex-column flex-items-center gap-md">
    <h2 class="flex-self-start">Criar Consulta</h2>
    <Form
        path={`/api/appointment`}
        method="POST"
        class="content-wrapper card-lg flex-column"
    >
        <AppointmentFieldset appointment={{ pacient, date: new Date() }}/>
        <div class="flex-row">
            <div class="flex-grow"/>
            <Button type="submit">
                <SaveIcon width="1rem" height="1rem"/>
                Salvar
            </Button>
            <Anchor href={`/pacient/${pacient.id}`}>
                <CrossIcon width="1rem" height="1rem"/>
                Cancelar
            </Anchor>
        </div>
    </Form>
</LoggedInPage>