---
import { z } from "astro:content";

import SearchIcon from "@components/icons/Search.astro";
import LoggedInPage from "@components/LoggedInPage.astro"
import Anchor from "@components/Anchor.astro";
import PaginationControls from "@components/PaginationControls.astro";
import numberOrString from "@core/shared/schemas/number_or_string";
import searchParam from "@core/shared/utils/searchParam";
import { UserSchema } from "@core/user/types";
import { TreatmentSchema } from "@core/treatment/types";
import { config, treatmentRepository } from "src"

const ListTreatmentsDto = z.object({
	userId: UserSchema.shape.id,
	searchTerm: TreatmentSchema.shape.name.default(''),
	pageNumber: numberOrString.default(1),
	pageSize: numberOrString.default(config.treatmentListDefaultPageSize)
});

const { userId, searchTerm, pageNumber, pageSize } = ListTreatmentsDto.parse({ 
	userId: Astro.locals.userId, 
	searchTerm: searchParam(Astro.url, 'searchTerm'),
	pageNumber: searchParam(Astro.url, 'pageNumber'),
	pageSize: searchParam(Astro.url, 'pageSize')
});

const treatments = await treatmentRepository.findAll(userId, searchTerm, { number: pageNumber, size: pageSize });

---
<LoggedInPage title="Tratamentos" class="flex-column flex-items-center gap-lg">
	<form 
		action="/treatment" 
		method="get" 
		class="content-wrapper card-md flex-row"
	>
		<input 
			type="text" 
			name="searchTerm" 
			placeholder="Pesquisar" 
			value={searchTerm} 
			class="flex-grow padding-md border-none"
		/>
		<button 
			type="submit" 
			class="padding-x-md border-radius content-evidence"
		>
			<SearchIcon width="1.5rem" height="1.5rem"/>
		</button>
	</form>
	<div class="content-wrapper card-lg flex-column">
		<header class="content-faded padding-md border-bottom">
			Tratamentos
		</header>
		<div class="flex-column items-padding-md">
			{treatments.data.map(treatment => (
				<a href={`/treatment/${treatment.id}`}>{treatment.name}</a>
			))}
		</div>
		<div class="flex-row flex-space-between">
			<Anchor href="/treatment/create" >                    
				+ Novo Tratamento
			</Anchor>
			<PaginationControls 
				pageNumber={pageNumber}
				pageSize={pageSize}
				totalCount={treatments.count}
				href={`/treatment?searchTerm=${searchTerm}`}
			/>
		</div>
	</div>
</LoggedInPage>
