---
import { z } from "astro:content";

import Anchor from "@components/Anchor.astro";
import Button from "@components/Button.astro";
import TreatmentFieldset from "@components/fieldsets/TreatmentFieldset.astro";
import Form from "@components/Form.astro";
import CrossIcon from "@components/icons/Cross.astro";
import SaveIcon from "@components/icons/Save.astro";
import TrashIcon from "@components/icons/Trash.astro";
import LoggedInPage from "@components/LoggedInPage.astro";
import { TreatmentSchema } from "@core/treatment/types";
import { UserSchema } from "@core/user/types";
import { treatmentRepository } from "src";

const GetTreatmentDto = z.object({
	userId: UserSchema.shape.id,
	treatmentId: TreatmentSchema.shape.id,
});

const { userId, treatmentId } = GetTreatmentDto.parse({ 
	userId: Astro.locals.userId, 
    treatmentId: Astro.params.treatmentId,
});

const treatment = await treatmentRepository.findById(userId, treatmentId);

---
<LoggedInPage title="Editar Tratamento" class="flex-column flex-items-center gap-md">
    <h2 class="flex-self-start">Editar Tratamento</h2>
    <Form
        path={`/api/treatment/${treatment.id}`}
        method="PUT"
        class="content-wrapper card-lg flex-column"
    >
        <TreatmentFieldset treatment={treatment}/>
        <div class="flex-row">
            {/* to-do: Alert before deleting */}
            <Button 
                class="content-alert" 
                onClickPath={`/api/treatment/${treatment.id}`} 
                onClickMethod="DELETE"
            >
                <TrashIcon width="1rem" height="1rem"/>
                Deletar
            </Button>
            <div class="flex-grow"/>
            <Button 
                type="submit"
            >
                <SaveIcon width="1rem" height="1rem"/>
                Salvar
            </Button>
            <Anchor href={`/treatment/${treatment.id}`}>
                <CrossIcon width="1rem" height="1rem"/>
                Cancelar
            </Anchor>
        </div>
    </Form>
</LoggedInPage>