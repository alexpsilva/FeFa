---
import { z } from "astro:content";

import Anchor from "@components/Anchor.astro";
import Button from "@components/Button.astro";
import AppointmentFieldset from "@components/fieldsets/AppointmentFieldset.astro";
import Form from "@components/Form.astro";
import CrossIcon from "@components/icons/cross";
import SaveIcon from "@components/icons/save";
import TrashIcon from "@components/icons/trash";
import LoggedInPage from "@components/LoggedInPage.astro";
import { AppointmentSchema } from "@core/appointment/types";
import { UserSchema } from "@core/user/types";
import { appointmentRepository } from "src";

const GetAppointmentDto = z.object({
	userId: UserSchema.shape.id,
	appointmentId: AppointmentSchema.shape.id,
});

const { userId, appointmentId } = GetAppointmentDto.parse({ 
	userId: Astro.locals.userId, 
    appointmentId: Astro.params.appointmentId,
});

const appointment = await appointmentRepository.findById(userId, appointmentId);

---
<LoggedInPage title="Editar Consulta" class="flex-column flex-items-center gap-md">
    <h2 class="flex-self-start">Editar Consulta</h2>
    <Form
        path={`/api/appointment/${appointment.id}`}
        method="PUT"
        class="content-wrapper card-lg flex-column"
    >
        <AppointmentFieldset appointment={appointment}/>
        <div class="flex-row">
            {/* to-do: Alert before deleting */}
            <Button 
                class="content-alert" 
                onClickPath={`/api/appointment/${appointment.id}`}
                onClickMethod="DELETE"
            >
                <TrashIcon width="1rem" height="1rem"/>
                Deletar
            </Button>
            <div class="flex-grow"/>
            <Button type="submit">
                <SaveIcon width="1rem" height="1rem"/>
                Salvar
            </Button>
            {/* to-do: Make it go back on the history instead of a hard-coded url */}
            <Anchor href={`/pacient/${appointment.pacientId}`}>
                <CrossIcon width="1rem" height="1rem"/>
                Cancelar
            </Anchor>
        </div>
    </Form>
</LoggedInPage>