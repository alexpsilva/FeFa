---
import { z } from "astro:content";

import Anchor from "@components/Anchor.astro";
import ArrowIcon from "@components/icons/Arrow.astro";
import PenIcon from "@components/icons/Pen.astro";
import LoggedInPage from "@components/LoggedInPage.astro";
import MedicationFieldset from "@components/fieldsets/MedicationFieldset.astro";
import { UserSchema } from "@core/user/types";
import { MedicationSchema } from "@core/medication/types";
import { medicationRepository } from "src";

const GetMedicationDto = z.object({
	userId: UserSchema.shape.id,
	medicationId: MedicationSchema.shape.id,
});

const { userId, medicationId } = GetMedicationDto.parse({ 
	userId: Astro.locals.userId, 
    medicationId: Astro.params.medicationId
});

const medication = await medicationRepository.findById(userId, medicationId);

---
<LoggedInPage title="Tratamento" class="flex-column flex-items-center gap-md">
    <Anchor href="/medication" class="flex-self-start">
        <ArrowIcon direction="left" width="1.5rem" height="1.5rem"/>
        <span>Voltar</span>
    </Anchor>
    <div class="content-wrapper card-lg flex-column">
        <MedicationFieldset
            medication={medication} 
            disabled
        />
        <Anchor href={`/medication/${medicationId}/edit`} class="flex-self-end">
            <PenIcon width="1rem" height="1rem"/>
            Editar
        </Anchor>
    </div>
</LoggedInPage>