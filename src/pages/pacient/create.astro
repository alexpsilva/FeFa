---
import LoggedInPage from "@components/LoggedInPage.astro"
import Anchor from "@components/Anchor.astro";
import CrossIcon from "@components/icons/Cross.astro";
import SaveIcon from "@components/icons/Save.astro";
import Button from "@components/Button.astro";
import Form from "@components/Form.astro";
import PacientFieldset from "@components/fieldsets/PacientFieldset.astro";

---
<LoggedInPage title="Criar Paciente" class="flex-column flex-items-center gap-md">
	<h2 class="flex-self-start">Criar Paciente</h2>
	<Form
		path="/api/pacient"
		method="POST"
		class="content-wrapper card-lg flex-column"
	>
		<PacientFieldset />
		<div class="flex-row">
			<div class="flex-grow"/>
			<Button type="submit">
				<SaveIcon width="1rem" height="1rem"/>
				Salvar
			</Button>
			<Anchor href="/pacient">
				<CrossIcon width="1rem" height="1rem"/>
				Cancelar
			</Anchor>
		</div>
	</Form>
</LoggedInPage>
