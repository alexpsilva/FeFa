---
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'svg'> {
    direction: 'up' | 'down' | 'left' | 'right'
}

const { direction, ...props } = Astro.props;
let rotation: number
switch (direction) {
    case 'up': rotation = 0; break;
    case 'right': rotation = 90; break;
    case 'down': rotation = 180; break;
    case 'left': rotation = 270; break;
}

---

<svg
    viewBox='0 0 25 25'
    stroke-width='3'
    fill='none'
    stroke-linecap='round'
    stroke-linejoin='round'
    {...props}
    >
    <path
        transform={`rotate(${rotation}, 13, 13)`}
        d='M13 23 V2 L7 8 M13 2 L19 8'
        fill='none'
    />
    </svg>