---
import type { HTMLAttributes } from 'astro/types'
import type { Medication } from '@core/medication/types'

export interface Props extends HTMLAttributes<'fieldset'> {
    medication?: Partial<Medication>
}

const { medication, ...props } = Astro.props
---

<fieldset class="padding-lg grid-flow-row grid-cols-2 gap-md" {...props}>
    <div class="flex-column">
        <label for="name" class="content-faded text-sm">Nome</label>
        <input id="name" name="name" type="text" value={medication?.name}/>
    </div>
</fieldset>