---
import { z } from "astro:content";

import Anchor from "@components/Anchor.astro";
import Button from "@components/Button.astro";
import MedicationFieldset from "@components/fieldsets/MedicationFieldset.astro";
import Form from "@components/Form.astro";
import CrossIcon from "@components/icons/Cross.astro";
import SaveIcon from "@components/icons/Save.astro";
import TrashIcon from "@components/icons/Trash.astro";
import LoggedInPage from "@components/LoggedInPage.astro";
import { MedicationSchema } from "@core/medication/types";
import { UserSchema } from "@core/user/types";
import { medicationRepository } from "src";

const GetMedicationDto = z.object({
	userId: UserSchema.shape.id,
	medicationId: MedicationSchema.shape.id,
});

const { userId, medicationId } = GetMedicationDto.parse({ 
	userId: Astro.locals.userId, 
    medicationId: Astro.params.medicationId,
});

const medication = await medicationRepository.findById(userId, medicationId);

---
<LoggedInPage title="Editar Tratamento" class="flex-column flex-items-center gap-md">
    <h2 class="flex-self-start">Editar Tratamento</h2>
    <Form
        path={`/api/medication/${medication.id}`}
        method="PUT"
        class="content-wrapper card-lg flex-column"
    >
        <MedicationFieldset medication={medication}/>
        <div class="flex-row">
            {/* to-do: Alert before deleting */}
            <Button 
                class="content-alert" 
                onClickPath={`/api/medication/${medication.id}`} 
                onClickMethod="DELETE"
            >
                <TrashIcon width="1rem" height="1rem"/>
                Deletar
            </Button>
            <div class="flex-grow"/>
            <Button 
                type="submit"
            >
                <SaveIcon width="1rem" height="1rem"/>
                Salvar
            </Button>
            <Anchor href={`/medication/${medication.id}`}>
                <CrossIcon width="1rem" height="1rem"/>
                Cancelar
            </Anchor>
        </div>
    </Form>
</LoggedInPage>